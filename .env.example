# Copy to .env for local proxy development. .env is gitignored; never commit the real key.
#
# Cloudflare Worker:  npx wrangler secret put FANTASYPROS_API_KEY
# Local worker dev:   put the same line in .dev.vars (also gitignored)
# Vercel / Netlify:   set it in the host's environment variable settings
FANTASYPROS_API_KEY=your_key_here

# Comma-separated origins allowed to call the proxy. Leave unset only while testing.
ALLOWED_ORIGINS=https://yourname.github.io,http://localhost:8000
